# Chép file này thành .env rồi điền. File .env KHÔNG được đưa lên kho mã nguồn.

# Công khai được — nhưng chỉ an toàn khi mọi bảng đã bật khoá dòng dữ liệu.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Số Zalo của công ty cho mục hỏi chuyên gia. Không dùng số riêng của từng thầy.
EXPO_PUBLIC_ZALO_CONG_TY=

# ----------------------------------------------------------------------------
# Mấy khoá dưới đây CHỈ đặt trong Edge Function, không bao giờ để trong app.
# Đặt bằng: npx supabase secrets set TEN_KHOA=gia_tri
#
#   SUPABASE_SERVICE_ROLE_KEY=
#   ANTHROPIC_API_KEY=
